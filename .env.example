# Copy to .env.local and adjust. Validated by env.ts at startup.

# --- Public (inlined into the browser bundle; NEVER put secrets here) --------
NEXT_PUBLIC_APP_NAME="AirCloud Frontend"
NEXT_PUBLIC_APP_URL="https://app.aircloud.com.pl"

# --- Server-only (kept out of the client bundle) ----------------------------
API_BASE_URL="https://api.aircloud.com.pl"
